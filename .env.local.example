# SMTP Configuration for email sending via Google Workspace
# Copy this file to .env.local and fill in your credentials
# NOTE: With MFA enabled, use an App Password (not your regular password)
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=
# SMTP credentials are per-purpose. Each purpose X reads SMTP_USER_X and SMTP_PASS_X.
# To add a new purpose: extend the Purpose union in src/utils/sendEmail.ts and add the 2 env vars here.
# BREAKING: production .env.local must rename SMTP_USER → SMTP_USER_FACTURACION and SMTP_PASS → SMTP_PASS_FACTURACION.
SMTP_USER_FACTURACION=
SMTP_PASS_FACTURACION=
SMTP_USER_CONSOLIDADOS=
SMTP_PASS_CONSOLIDADOS=
# CRM panel dedicated sender (purpose 'crm', NO cross-purpose fallback).
# Missing vars fail every CRM send fast with MissingSmtpCredsError.
SMTP_USER_CRM=
SMTP_PASS_CRM=

# File server (LAN UNC share, read-only, anonymous on LAN).
# Production Windows runtime resolves this directly via Node fs.
# Example: \\host\share  (NO trailing slash, NO host duplication).
FILE_SERVER_BASE_PATH=

# SQL Server — SIGLA / ICCGSA (consumed by `getPool()` in src/lib/db.ts).
# Used by the consolidados / informes routes to read SIGLA data.
# The legacy `DB_*` env vars below MUST stay in place; the legacy code
# reads them by name.
DB_HOST=
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_NAME=SIGLA           # SIGLA is the operational database used by the explorador_datos user

# SQL Server — HOLOMEDIC (consumed by `getHolomedicPool()` in src/lib/db.ts).
# Used by the email template editor (`getTemplateDb`) to read/write the
# `templates` and `template_versions` tables in `dbo`.
#
# `HOLOMEDIC_DB_HOST`, `_USER`, `_PASSWORD`, and `_PORT` are OPTIONAL —
# if any of them is set, the whole pool switches onto the
# `HOLOMEDIC_DB_*` prefix. If all are unset, the pool falls back to the
# SIGLA `DB_*` env vars (shared SQL Server instance, different database).
# `HOLOMEDIC_DB_NAME` is always read.
HOLOMEDIC_DB_NAME=HOLOMEDIC
# HOLOMEDIC_DB_HOST=172.16.10.14
# HOLOMEDIC_DB_PORT=1433
# HOLOMEDIC_DB_USER=
# HOLOMEDIC_DB_PASSWORD=

# SIGLA.PdfCli.exe SQL login — optional override for the PDF CLI; defaults to the HOLOMEDIC_DB_*/DB_* chain.
# PDFCLI_DB_USER=
# PDFCLI_DB_PASSWORD=

# Canal WhatsApp vía Kapso (agente-ia-crm) — la Guía gestiona conversaciones del CRM.
# KAPSO_MODO — 3 semánticas:
#   real      → envía por la API de Kapso (requiere KAPSO_API_KEY + KAPSO_PHONE_NUMBER_ID).
#   simulado  → simulador sin red; permitido TAMBIÉN en producción (opt-in consciente).
#   (vacío)   → dev: simulado con console.warn al arrancar | prod: FAIL CLOSED
#               (todo envío falla con KAPSO_NO_CONFIGURADO — nunca simular en silencio).
KAPSO_MODO=
# API key de la cuenta Kapso (salida de mensajes; solo en modo real).
KAPSO_API_KEY=
# phone_number_id de Kapso — identifica el número de WhatsApp conectado.
KAPSO_PHONE_NUMBER_ID=
# Timeout en ms de cada envío saliente por Kapso (default 15000). El SDK
# v0.3.0 no expone signal/timeout, el adapter aplica un race con timeout
# propio que devuelve KAPSO_TIMEOUT al vencer.
KAPSO_TIMEOUT_MS=15000
# Secret HMAC-SHA256 del webhook /api/webhooks/kapso: FIRMA OBLIGATORIA en
# producción — sin esta variable el webhook responde 503 (fail closed).
KAPSO_WEBHOOK_SECRET=
