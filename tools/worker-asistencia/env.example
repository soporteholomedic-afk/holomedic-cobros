# Plantilla de entorno del worker de asistencia (ZKTeco K20 Pro).
#
# Cómo usarla:
#   sudo cp tools/worker-asistencia/env.example /etc/worker-asistencia.env
#   (editar con los valores reales del servidor)
#   sudo chown root:worker-asistencia /etc/worker-asistencia.env
#   sudo chmod 640 /etc/worker-asistencia.env
#
# NUNCA commitear este archivo con valores reales: DEVICE_TOKEN es una
# credencial que el provisioning muestra UNA sola vez (ver el runbook
# docs/ops/RUNBOOK-asistencia-go-live.md).

# ---- REQUERIDAS: el worker no arranca si falta alguna ----

# IP del lector ZKTeco K20 Pro en la red del servidor.
DEVICE_IP=172.16.10.120

# Código único del dispositivo tal como se registró en el provisioning.
DEVICE_CODIGO=K20-SEDE1

# URL base de la API de asistencia de la app (sin barra final).
API_BASE_URL=http://localhost:3000/api/asistencia

# Token Bearer del dispositivo, emitido por provisionar_dispositivo.mjs.
DEVICE_TOKEN=REEMPLAZAR_CON_TOKEN_DEL_PROVISIONING

# ---- OPCIONALES: defaults exactos de worker/config.py ----

# Puerto TCP del lector ZKTeco.
#DEVICE_PORT=4370

# Ruta del buffer SQLite. EN PRODUCCIÓN descomentar con ruta absoluta:
# el default del código es RELATIVO (buffer.sqlite3 caería dentro de
# /opt/worker-asistencia, mezclando código con datos) y NO debe usarse.
#DB_PATH=/var/lib/worker-asistencia/buffer.sqlite3

# Segundos entre latidos hacia el servidor.
#HEARTBEAT_SEG=60

# Cantidad máxima de marcaciones por POST.
#LOTE_MAX=200

# Segundos entre vueltas del bucle de envío.
#SENDER_INTERVALO_SEG=10

# Hora del pull diario de usuarios/comandos, formato HH:MM (24 horas).
#PULL_HORA=02:30

# Backoff exponencial ante fallos: base en segundos.
#BACKOFF_BASE_SEG=5

# Backoff exponencial ante fallos: techo en segundos.
#BACKOFF_MAX_SEG=300
